{
  "name": "Diseño Web Profesional (sitio estático)",
  "install": "./scripts/cloud-agent-install.sh",
  "start": "./scripts/cloud-agent-start.sh",
  "ports": [{ "name": "web", "port": 8000 }],
  "terminals": [
    {
      "name": "web",
      "command": "python3 -m http.server 8000 --bind 0.0.0.0",
      "description": "Servidor web estático que sirve el sitio en http://localhost:8000"
    }
  ]
}
